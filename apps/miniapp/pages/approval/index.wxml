<view class="container"><view class="brand">{{name}}的审批工作台</view><view class="muted">仅展示服务端授权且已到当前节点的申请。多任课教师申请需全部完成首审。</view><view class="card" wx:for="{{pending}}" wx:key="id"><view class="label">{{item.student}} · {{item.class_name}}</view><view class="tag">#{{item.id}} · {{item.status}} · 跨度 {{item.span_days}} 天</view><view class="muted">{{item.start_date}} 至 {{item.end_date}}</view><view class="label">{{item.reason}}</view><view class="muted">影响 {{item.targets.length}} 节课</view><button class="secondary" wx:if="{{item.attachment_id}}" data-id="{{item.attachment_id}}" bindtap="image">查看凭证图片</button><textarea placeholder="审批意见（驳回必填）" data-id="{{item.id}}" bindinput="opinion"/><button data-id="{{item.id}}" data-decision="APPROVED" bindtap="decide" disabled="{{busy}}">通过</button><button class="danger" data-id="{{item.id}}" data-decision="REJECTED" bindtap="decide" disabled="{{busy}}">驳回</button></view><view wx:if="{{!pending.length}}" class="card muted">当前没有待办申请</view><view class="label">申请记录</view><view class="card" wx:for="{{history}}" wx:key="id">#{{item.id}} · {{item.student}} · {{item.status}}</view><view class="label">站内通知</view><view class="card" wx:for="{{notifications}}" wx:key="id">{{item.body}}</view><button class="secondary" bindtap="refresh">刷新</button><button class="secondary" bindtap="logout">退出登录</button></view>
