page{background:#f7f8fc;color:#26324a;font-size:28rpx}.container{padding:36rpx}.brand{font-size:46rpx;font-weight:700;margin:20rpx 0 36rpx}.card{background:#fff;border-radius:24rpx;padding:30rpx;margin:24rpx 0;box-shadow:0 8rpx 40rpx #27344d08}.label{font-weight:600;margin:24rpx 0 14rpx}.muted{color:#7f8a9f;line-height:1.7;font-size:24rpx}input,textarea,picker{border:1rpx solid #e3e7f0;border-radius:14rpx;padding:22rpx;margin:14rpx 0}textarea{width:auto;height:170rpx}button{background:#7766ed;color:white;border-radius:14rpx;font-size:28rpx;margin:20rpx 0}button.secondary{background:#eef0fc;color:#6b5bcc}button.danger{background:#ed6977}.row{display:flex;align-items:center;gap:16rpx;padding:14rpx 0;border-bottom:1rpx solid #f1f2f7}.grow{flex:1}.tag{color:#7766ed;font-size:24rpx}.material{width:100%;height:300rpx}
